<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Insert the Night Safety autonomy column into the Assign table. Guarded so it cannot fail
    silently: if the vanilla "RemainingSpace" column is present we splice the new column in
    front of it (with a gap); if another mod has already moved or removed that column, we fall
    back to simply appending the new column to the list instead of matching nothing.
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnTableDef[defName="Assign"]/columns/li[text()="RemainingSpace"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnTableDef[defName="Assign"]/columns/li[text()="RemainingSpace"]</xpath>
      <value>
        <li>GapTiny</li>
        <li>NightSafety_SafetySeeking</li>
        <li>RemainingSpace</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnTableDef[defName="Assign"]/columns</xpath>
      <value>
        <li>NightSafety_SafetySeeking</li>
      </value>
    </nomatch>
  </Operation>
</Patch>
