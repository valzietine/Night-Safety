<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>NightSafety_HarassmentEffigy</defName>
    <label>harassment effigy</label>
    <description>A crude marker left by night harassers. It serves no purpose beyond intimidation and obstruction.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/Urn</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>25</pathCost>
    <fillPercent>0.2</fillPercent>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <destroyable>true</destroyable>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>1</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
    </building>
  </ThingDef>
</Defs>
