<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>NightSafety_ProtectionOven</defName>
    <label>protection oven</label>
    <description>A wood-fired oven whose warmth marks a circle of safety during the night.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Misc/Campfire</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <uiIconPath>Things/Building/Misc/Campfire_MenuIcon</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <constructEffect>ConstructDirt</constructEffect>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.2</fillPercent>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
      <Steel>20</Steel>
    </costList>
    <designationCategory>Temperature</designationCategory>
    <designationHotKey>Misc1</designationHotKey>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <rotatable>false</rotatable>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>10</fuelConsumptionRate>
        <fuelCapacity>30</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>0</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <functionsInVacuum>false</functionsInVacuum>
      </li>
      <li Class="NightSafety.Buildings.CompProperties_ProtectionOven">
        <radius>12</radius>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>1</fireSize>
      </li>
    </comps>
    <building>
      <destroySound>BuildingDestroyed_Wood_Small</destroySound>
    </building>
  </ThingDef>
</Defs>
