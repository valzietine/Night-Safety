<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <NightSafety.Core.StemrootConfigDef>
    <defName>NightSafety_StemrootConfig</defName>

    <!-- Regrowth after damage. One in-game hour of quiet, then a hit point a second. -->
    <regenDelayTicks>2500</regenDelayTicks>
    <regenTicksPerHitPoint>60</regenTicksPerHitPoint>

    <!-- How often a cell rolls for a state of its own, and how likely each outcome is. -->
    <stateCheckIntervalTicks>2500</stateCheckIntervalTicks>
    <bleedChance>0.02</bleedChance>
    <bleedPollutionScale>0.08</bleedPollutionScale>
    <bloomChance>0.06</bloomChance>
    <bloomMinTemperature>10</bloomMinTemperature>
    <bloomIdealTemperature>30</bloomIdealTemperature>
    <flushChance>0.05</flushChance>

    <!-- State countdowns. Bleeding and blooming run a few hours; fruit keeps two days. -->
    <bleedDurationMinTicks>7500</bleedDurationMinTicks>
    <bleedDurationMaxTicks>15000</bleedDurationMaxTicks>
    <bloomDurationMinTicks>7500</bloomDurationMinTicks>
    <bloomDurationMaxTicks>15000</bloomDurationMaxTicks>
    <fruitDurationTicks>120000</fruitDurationTicks>
    <sapFilthIntervalTicks>900</sapFilthIntervalTicks>

    <!-- Yields. All of these are meant to be trace amounts, not a farm. -->
    <cutWoodCount>30</cutWoodCount>
    <bleedingYieldCount>20</bleedingYieldCount>
    <fruitingYieldCount>10</fruitingYieldCount>
    <flushingYieldCount>11</flushingYieldCount>
    <cutWork>1100</cutWork>
    <harvestWork>420</harvestWork>

    <!-- What touching the roots costs. The affliction is the real gate on farming them. -->
    <cutAfflictionSeverity>0.15</cutAfflictionSeverity>
    <harvestAfflictionSeverity>0.05</harvestAfflictionSeverity>
  </NightSafety.Core.StemrootConfigDef>
</Defs>
