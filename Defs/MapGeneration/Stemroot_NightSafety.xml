<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Order 1150 puts stemroot in the late non-critical band, after rock, ruins, and the player
    start spot are settled, so it fills in around them instead of fighting them for cells.
  -->
  <GenStepDef>
    <defName>NightSafety_Stemroot</defName>
    <order>1150</order>
    <genStep Class="NightSafety.Stemroot.GenStep_Stemroot">
      <countPer10kCellsRange><min>1.2</min><max>2.4</max></countPer10kCellsRange>
      <patchRadiusRange><min>6</min><max>13</max></patchRadiusRange>
      <!--
        A patch fills solid out to this share of its radius and only breaks up over the band past
        it, so the middle of a stand is a wall and only the rim is ragged. The stretch runs each
        patch along its own axis instead of growing it as a disc, which is what makes a stand read
        as a run of roots. Raising the stretch on its own costs coverage, since a patch fills an
        ellipse of semi-major radius and semi-minor radius over stretch: move the radius with it.
      -->
      <solidCoreFraction>0.55</solidCoreFraction>
      <patchStretchRange><min>3.6</min><max>5.4</max></patchStretchRange>
      <playerStartClearance>22</playerStartClearance>
    </genStep>
  </GenStepDef>
</Defs>
